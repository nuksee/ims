<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Domain model, provider abstraction and services.

    Deliberately targets plain net9.0 with no Windows or ODBC dependency.
    NFR-5 asks that a later cross-platform client not be gratuitously
    precluded, and this project is where that promise is kept: if the
    provider ever changes, only Ims.Data.Informix should need rewriting.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Ims.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />

    <!-- PR-4.6 Excel export. Cross-platform, so Ims.Core stays portable (NFR-5). -->
    <PackageReference Include="ClosedXML" />
  </ItemGroup>

  <ItemGroup>
    <!-- ResultExporter.Quote is internal; RFC 4180 quoting deserves direct tests. -->
    <InternalsVisibleTo Include="Ims.Core.Tests" />
  </ItemGroup>

</Project>
