<Window x:Class="Ims.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ims.App"
        xmlns:vm="clr-namespace:Ims.App.ViewModels"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Informix Management Studio"
        Icon="Resources/ims.ico"
        Height="820" Width="1320"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">

  <!--
    Layout follows SSMS (PR-8.1): registered servers on the left, a tabbed query
    editor on the right, results beneath it, status along the bottom. The users'
    existing muscle memory is an asset.
  -->

  <Window.Resources>
    <local:InformixValueConverter x:Key="ValueConverter" />
    <local:InformixValueIsNullConverter x:Key="IsNullConverter" />
    <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:CountToVisibilityConverter x:Key="CountToVisibility" />
    <local:NotNullToBooleanConverter x:Key="NotNullToBool" />
    <local:NullToVisibilityConverter x:Key="NullToVisibility" />
    <local:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
    <local:JoinListConverter x:Key="JoinList" />
    <local:EnvironmentBrushConverter x:Key="EnvironmentBrush" />
    <local:TransactionStateConverter x:Key="TransactionText" />
    <local:StatementOutcomeConverter x:Key="OutcomeText" />
  </Window.Resources>

  <!--
    PR-3.10: execute, cancel and new tab from the keyboard, using the gestures
    SSMS users already have in their fingers (PR-8.1).

    These are RoutedUICommands declared in code-behind, not {Binding} to view-model
    commands. The first attempt bound to ExecuteCommand on the window's DataContext,
    which is MainViewModel — but that command lives on EditorTabViewModel, so the
    binding silently resolved to nothing and F5 did exactly that. A routed command
    also reaches the handler when focus is inside the editor, which a KeyBinding on
    the window does not reliably do.
  -->

  <DockPanel>

    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New query" Command="{x:Static local:MainWindow.NewQueryCommand}" />
        <MenuItem Header="_Open…" Command="{x:Static local:MainWindow.OpenFileCommand}" />
        <MenuItem Header="_Save" Command="{x:Static local:MainWindow.SaveFileCommand}" />
        <MenuItem Header="Save _as…" Click="OnSaveFileAs" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Query">
        <MenuItem Header="_Execute" Command="{x:Static local:MainWindow.ExecuteCommand}" />
        <MenuItem Header="Execute _selection" Command="{x:Static local:MainWindow.ExecuteSelectionCommand}" />
        <MenuItem Header="_Cancel" Command="{x:Static local:MainWindow.CancelExecutionCommand}" />
        <Separator />
        <!-- Listed so the gesture is discoverable; PR-3.2 is not much use unfound. -->
        <MenuItem Header="Complete _word" Command="{x:Static local:MainWindow.CompleteCommand}" />
        <Separator />
        <MenuItem Header="Commit" Click="OnCommit" />
        <MenuItem Header="Roll back" Click="OnRollback" />
      </MenuItem>
      <MenuItem Header="_Connection">
        <MenuItem Header="_New connection…" Click="OnNewConnection" />
        <MenuItem Header="_Edit selected…" Click="OnEditConnection" />
        <MenuItem Header="_Remove selected" Click="OnRemoveConnection" />
      </MenuItem>
      <MenuItem Header="_Results">
        <MenuItem Header="Export to _CSV…" Click="OnExportCsv" />
        <MenuItem Header="Export to _tab-delimited…" Click="OnExportTsv" />
        <MenuItem Header="Export to _JSON…" Click="OnExportJson" />
        <MenuItem Header="Export to _Excel…" Click="OnExportExcel" />
        <Separator />
        <MenuItem Header="Copy selection" Click="OnCopySelection" />
        <MenuItem Header="Fetch more rows" Click="OnFetchMore" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Contents" Command="{x:Static local:MainWindow.HelpContentsCommand}" />
        <Separator />
        <MenuItem Header="Query _history…" Click="OnShowHistory" />
        <MenuItem Header="_About IMS" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="CsdkStatusText" AutomationProperties.Name="Client SDK status" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding SelectedTab.TargetLabel, FallbackValue='Not connected'}"
                   AutomationProperties.Name="Target instance" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <!-- PR-3.7: transaction state is visible at all times, in words. -->
        <TextBlock Text="{Binding SelectedTab.TransactionState, Converter={StaticResource TransactionText}}"
                   AutomationProperties.Name="Transaction state" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Text="{Binding StatusText}" AutomationProperties.Name="Status" />
      </StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="290" MinWidth="200" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Margin="6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="120" MaxHeight="320" />
          <RowDefinition Height="4" />
          <RowDefinition Height="*" MinHeight="140" />
        </Grid.RowDefinitions>

      <!-- Instance list (PR-1.2) -->
      <DockPanel Grid.Row="0">
        <TextBox DockPanel.Dock="Top"
                 Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,6" Padding="4,3"
                 AutomationProperties.Name="Search connections" />

        <ListBox x:Name="ConnectionList"
                 ItemsSource="{Binding Connections}"
                 SelectedItem="{Binding SelectedConnection}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="OnConnect"
                 AutomationProperties.Name="Saved connections">
          <!-- The menu is a resource, not inline in the Setter below. A Click
               handler on a MenuItem inside a Style setter cannot be wired up as an
               instance event: the XAML compiler emits AddHandler against the wrong
               target type and the window throws on load. As a keyed resource the
               items are ordinary named elements again, and the handlers bind. -->
          <ListBox.Resources>
            <ContextMenu x:Key="ConnectionContextMenu">
              <MenuItem Header="C_onnect" Click="OnConnect"
                        Visibility="{Binding PlacementTarget.DataContext.IsConnected,
                                     RelativeSource={RelativeSource Self},
                                     Converter={StaticResource BoolToVisibility},
                                     ConverterParameter=Invert}" />
              <MenuItem Header="_Disconnect" Click="OnDisconnect"
                        Visibility="{Binding PlacementTarget.DataContext.IsConnected,
                                     RelativeSource={RelativeSource Self},
                                     Converter={StaticResource BoolToVisibility}}" />
              <Separator />
              <MenuItem Header="_Edit…" Click="OnEditConnection" />
              <MenuItem Header="_Remove" Click="OnRemoveConnection" />
            </ContextMenu>
          </ListBox.Resources>

          <!-- Right-clicking a row selects it first, so the menu always acts on
               the row under the cursor rather than the previous selection. -->
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnConnectionRightClick" />
              <Setter Property="ContextMenu" Value="{StaticResource ConnectionContextMenu}" />
            </Style>
          </ListBox.ItemContainerStyle>

          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="2,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Elided, not wrapped. The badge beside it is the one thing in this
                     row that must never be cut off (PR-1.5), so a long connection
                     name has to give way to it rather than push it off the edge. -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DisplayName}" />

                <!-- PR-1.5 and NFR-8: the word is the signal, the colour merely
                     reinforces it. This must be unmistakable to someone who cannot
                     tell red from green. -->
                <Border Grid.Row="0" Grid.Column="1"
                        Background="{Binding Environment, Converter={StaticResource EnvironmentBrush}}"
                        CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                  <TextBlock Text="{Binding EnvironmentLabel}"
                             Foreground="White" FontSize="10" FontWeight="Bold"
                             AutomationProperties.Name="Environment" />
                </Border>

                <!-- A database and host name runs long, and as one unwrapped line it
                     set the whole row's width — widening the item past the list's
                     viewport and carrying the badge in column 1 off the right edge
                     with it. Elided, so the row is only ever as wide as the list. -->
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding Detail}" FontSize="11" Foreground="#FF5F6368"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Detail}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                    Background="#FFE0E0E0" />

      <!--
        Object browser (PR-2.1 to PR-2.3, PR-2.7).

        Children load on first expansion (PR-2.2), the filter goes into the
        catalogue query rather than being applied to a fetched list (PR-2.3,
        NFR-2), and the context menu exposes the query behind whatever is
        selected (PR-8.2).
      -->
      <DockPanel Grid.Row="2">
        <TextBlock DockPanel.Dock="Top" Text="Objects" FontWeight="SemiBold" Margin="0,0,0,4" />

        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBox Grid.Column="0" Padding="4,3"
                   Text="{Binding ObjectTree.Filter, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                   IsEnabled="{Binding ObjectTree, Converter={StaticResource NotNullToBool}}"
                   AutomationProperties.Name="Filter objects by name" />

          <Button Grid.Column="1" Content="⟳" Margin="4,0,0,0" Padding="7,2"
                  ToolTip="Refresh the selected node"
                  Click="OnRefreshTreeNode"
                  AutomationProperties.Name="Refresh" />
        </Grid>

        <CheckBox DockPanel.Dock="Bottom" Margin="0,4,0,0"
                  Content="Show system objects"
                  IsChecked="{Binding ObjectTree.IncludeSystemObjects}"
                  IsEnabled="{Binding ObjectTree, Converter={StaticResource NotNullToBool}}"
                  ToolTip="Informix keeps its own catalogue at tabid 1-99." />

        <TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0" TextWrapping="Wrap"
                   Foreground="#FF5F6368" FontSize="11"
                   Text="Connect to an instance to browse its objects."
                   Visibility="{Binding ObjectTree, Converter={StaticResource NullToVisibility}}" />

        <TreeView x:Name="ObjectTreeView"
                  ItemsSource="{Binding ObjectTree.Roots}"
                  SelectedItemChanged="OnTreeSelectionChanged"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  AutomationProperties.Name="Database objects">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <!-- PR-2.2: children are fetched on first expansion, never up front. -->
              <EventSetter Event="Expanded" Handler="OnTreeItemExpanded" />
            </Style>
          </TreeView.ItemContainerStyle>

          <TreeView.ContextMenu>
            <!--
              Actions that do not apply to the selection are disabled rather than
              offered and then refused. Being told "no" after clicking teaches
              nothing; a greyed item shows what the selection is.
            -->
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                       RelativeSource={RelativeSource Self}}">
              <MenuItem Header="_SELECT first 100 rows"
                        Click="OnSelectFirstRows"
                        IsEnabled="{Binding ObjectTree.CanSelectRows, FallbackValue=False}" />
              <MenuItem Header="Show _detail"
                        Click="OnShowObjectDetail"
                        IsEnabled="{Binding ObjectTree.CanSelectRows, FallbackValue=False}" />
              <MenuItem Header="Script as CRE_ATE"
                        Click="OnScriptObject"
                        IsEnabled="{Binding ObjectTree.CanScriptSelection, FallbackValue=False}" />
              <MenuItem Header="_Copy qualified name"
                        Click="OnCopyQualifiedName"
                        IsEnabled="{Binding ObjectTree.HasSelectedObject, FallbackValue=False}" />
              <Separator />
              <MenuItem Header="Show the catalogue _query…" Click="OnShowCatalogQuery" />
              <MenuItem Header="_Refresh" Click="OnRefreshTreeNode" />
            </ContextMenu>
          </TreeView.ContextMenu>

          <TreeView.Resources>
            <HierarchicalDataTemplate DataType="{x:Type vm:ObjectFolderNodeViewModel}"
                                      ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" Margin="0,0,5,0" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="  (loading…)" Foreground="#FF5F6368"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </HierarchicalDataTemplate>

            <DataTemplate DataType="{x:Type vm:SchemaObjectNodeViewModel}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" Margin="0,0,5,0" />
                <TextBlock Text="{Binding Name}" />
                <TextBlock Text="{Binding Detail, StringFormat='  {0}'}"
                           Foreground="#FF5F6368" FontSize="11" />
              </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PlaceholderNodeViewModel}">
              <TextBlock Text="{Binding Name}" Foreground="#FF5F6368" FontStyle="Italic" />
            </DataTemplate>
          </TreeView.Resources>
        </TreeView>
      </DockPanel>
      </Grid>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                    Background="#FFE0E0E0" />

      <!-- Editor and results -->
      <Grid Grid.Column="2" Margin="0,6,6,6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="120" />
          <RowDefinition Height="4" />
          <RowDefinition Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <!-- Tab headers only. One editor control is shared between tabs, which keeps
             a single AvalonEdit instance and its undo stack predictable. -->
        <!--
          One row that scrolls, rather than WPF's default of wrapping onto extra rows.
          TabPanel wraps once the headers no longer fit, but this strip is a fixed 26px
          — so the second row was drawn outside it and those tabs became unreachable.
          Growing instead would be worse: the strip would eat the editor a row at a
          time, and tabs would jump between rows as the selected one is promoted.

          So: an ItemsPanel that does not wrap, inside a horizontal scroller. The strip
          keeps its height however many tabs are open, and the ones that do not fit are
          a scroll away rather than gone.

          The scrollbar itself is hidden rather than Auto. A visible horizontal bar is
          laid out *inside* the scroller, so it took ~17 of the strip's 26px the moment
          the tabs overflowed — leaving the headers a few pixels tall and looking cut
          off, which is the clipping this was supposed to have fixed. Scrolling is
          driven by the mouse wheel over the strip and by keeping the selected tab in
          view (see MainWindow.xaml.cs), so nothing is lost by not drawing the bar.

          The height is 30 rather than the old 26. WPF promotes the selected tab a
          couple of pixels past the others, so a header measures ~2px taller than the
          plain ones and 26 cut its bottom edge. Dropping the height and letting the
          row measure is not the answer — a ScrollViewer does not pass its content's
          desired height up, so the strip collapsed to 20px instead.
        -->
        <TabControl x:Name="TabHeaders" Grid.Row="0"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab}"
                    SelectionChanged="OnTabChanged"
                    BorderThickness="0"
                    Padding="0" Height="30">
          <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
              <ScrollViewer x:Name="TabScroller"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled"
                            PreviewMouseWheel="OnTabStripMouseWheel"
                            Focusable="False">
                <!-- ItemsPresenter, not a hardcoded TabPanel, so ItemsPanel below
                     actually takes effect. The content area is deliberately absent:
                     one shared AvalonEdit lives outside this control, and the
                     ContentTemplate is empty for the same reason. -->
                <ItemsPresenter />
              </ScrollViewer>
            </ControlTemplate>
          </TabControl.Template>

          <TabControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </TabControl.ItemsPanel>
          <!--
            Middle-click closes a tab. Hooked on the container rather than on the
            item template so the whole header is the target: aiming at the label is
            not how anyone middle-clicks a tab.

            It is an addition to the ✕ button, never a replacement — NFR-8 needs a
            way to close a tab that does not require a three-button mouse.
          -->
          <TabControl.ItemContainerStyle>
            <Style TargetType="TabItem">
              <EventSetter Event="MouseDown" Handler="OnTabHeaderMouseDown" />
            </Style>
          </TabControl.ItemContainerStyle>
          <TabControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <!-- Capped and elided: a tab named after a long file would otherwise
                     push every other tab off the strip on its own. The full title is
                     on the tooltip, so nothing is lost. -->
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                           MaxWidth="180" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Title}" />
                <Button Content="✕" Margin="6,0,0,0" Padding="3,0" FontSize="10"
                        BorderThickness="0" Background="Transparent"
                        Click="OnCloseTab"
                        ToolTip="Close this tab — or middle-click the tab"
                        AutomationProperties.Name="Close tab" />
              </StackPanel>
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate />
          </TabControl.ContentTemplate>
        </TabControl>

        <DockPanel Grid.Row="1">
          <!--
            Shown when a cancel freed the editor without stopping the statement, which
            is what this ODBC driver actually does (PR-3.5, measured). It sits above
            the editor rather than in the status bar because the status bar is
            transient and this has to survive the moment: the user's query is still
            consuming server CPU and the way to stop it is in this text.

            Not colour-alone (NFR-8): the wording carries the meaning and the ⚠ gives
            it a shape, so the amber is decoration rather than the signal.
          -->
          <Border DockPanel.Dock="Top"
                  Background="#FFFFF4CE" BorderBrush="#FFE0C060" BorderThickness="0,0,0,1"
                  Padding="8,5"
                  Visibility="{Binding SelectedTab.CancelNotice,
                               Converter={StaticResource NotNullToVisibility}}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="⚠" FontSize="14" Margin="0,0,8,0"
                         VerticalAlignment="Top" />
              <Button DockPanel.Dock="Right" Content="✕" Padding="4,0" FontSize="10"
                      BorderThickness="0" Background="Transparent"
                      VerticalAlignment="Top"
                      Click="OnDismissCancelNotice"
                      ToolTip="Dismiss"
                      AutomationProperties.Name="Dismiss the cancellation notice" />
              <TextBlock Text="{Binding SelectedTab.CancelNotice}"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="Cancellation notice" />
            </DockPanel>
          </Border>

          <avalonEdit:TextEditor x:Name="Editor"
                                 FontFamily="Consolas" FontSize="13"
                                 ShowLineNumbers="True"
                                 WordWrap="False"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="SQL editor" />
        </DockPanel>

        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                      Background="#FFE0E0E0" />

        <TabControl Grid.Row="3" x:Name="ResultsArea" SelectionChanged="OnBottomTabChanged">
          <TabItem Header="Results">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4">
                <TextBlock Text="{Binding SelectedTab.SelectedResult.Status}"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="Result status" />
                <Button Content="Fetch _more" Margin="12,0,0,0" Padding="8,2"
                        Click="OnFetchMore"
                        Visibility="{Binding SelectedTab.SelectedResult.HasMoreRows,
                                     Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>

              <!-- Several result sets kept at once (PR-4.7). Headers only; the grid
                   below is shared, so its dynamic columns are rebuilt once per
                   result rather than per tab switch. -->
              <TabControl x:Name="ResultSetTabs" DockPanel.Dock="Top"
                          ItemsSource="{Binding SelectedTab.Results}"
                          SelectedItem="{Binding SelectedTab.SelectedResult}"
                          SelectionChanged="OnResultSetChanged"
                          BorderThickness="0" Height="24"
                          Visibility="{Binding SelectedTab.Results.Count,
                                       Converter={StaticResource CountToVisibility},
                                       ConverterParameter=2}">
                <TabControl.ItemTemplate>
                  <DataTemplate>
                    <!-- The statement is on the tooltip, so the result can always be
                         traced back to what produced it (PR-8.2). -->
                    <TextBlock Text="{Binding Label}" ToolTip="{Binding Sql}" />
                  </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                  <DataTemplate />
                </TabControl.ContentTemplate>
              </TabControl>

              <DataGrid x:Name="ResultGrid"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserSortColumns="True"
                        SelectionUnit="CellOrRowHeader"
                        SelectionMode="Extended"
                        ClipboardCopyMode="IncludeHeader"
                        EnableRowVirtualization="True"
                        EnableColumnVirtualization="True"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        HeadersVisibility="All"
                        GridLinesVisibility="All"
                        FontFamily="Consolas" FontSize="12"
                        AutomationProperties.Name="Result grid" />
            </DockPanel>
          </TabItem>

          <TabItem Header="Messages">
            <!-- PR-3.4 and PR-3.6: each statement's outcome in sequence, with the
                 failing one named and its SQLCODE and ISAM error shown. -->
            <ListBox ItemsSource="{Binding SelectedTab.Outcomes}"
                     FontFamily="Consolas" FontSize="12"
                     HorizontalContentAlignment="Stretch"
                     AutomationProperties.Name="Statement messages">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource OutcomeText}}"
                             TextWrapping="Wrap" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </TabItem>

          <!--
            Object detail (PR-2.4). Loads only while this tab is showing (PR-6.4),
            and every Informix-specific term carries its explanation on the tooltip
            (NFR-11) — U2 will not know what a dbspace is.
          -->
          <TabItem x:Name="ObjectDetailTab" Header="Object">
            <Grid DataContext="{Binding ObjectTree.Detail}">
              <TextBlock Text="Select a table or view in the tree to see its detail."
                         Foreground="#FF5F6368" Margin="10"
                         Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility},
                                      ConverterParameter=Invert}" />

              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="10">

                  <TextBlock Text="{Binding Title}" Style="{StaticResource HeadingText}" />

                  <TextBlock Text="{Binding StorageSummary}" Margin="0,6,0,0"
                             TextWrapping="Wrap" Foreground="#FF3C4043" />

                  <TextBlock Text="{Binding StatisticsSummary}" Margin="0,4,0,10"
                             TextWrapping="Wrap" Foreground="#FF3C4043"
                             ToolTip="{x:Static vm:InformixConcepts.Statistics}" />

                  <Expander Header="Columns" IsExpanded="True" Margin="0,0,0,8">
                    <DataGrid ItemsSource="{Binding Detail.Columns}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              MaxHeight="320" FontFamily="Consolas" FontSize="12">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="40" />
                        <DataGridTextColumn Header="Column" Binding="{Binding Name}" Width="200" />
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeDescription}" Width="200" />
                        <DataGridCheckBoxColumn Header="Null?" Binding="{Binding IsNullable}" Width="55" />
                        <DataGridTextColumn Header="Default" Binding="{Binding DefaultValue}" Width="120" />
                        <!-- PR-8.2: the catalogue's own encoding, on show. -->
                        <DataGridTextColumn Header="coltype" Binding="{Binding RawColType}" Width="65" />
                        <DataGridTextColumn Header="collength" Binding="{Binding RawColLength}" Width="75" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Expander>

                  <Expander Header="Indexes" IsExpanded="True" Margin="0,0,0,8">
                    <DataGrid ItemsSource="{Binding Detail.Indexes}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              MaxHeight="200" FontFamily="Consolas" FontSize="12">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Index" Binding="{Binding Name}" Width="200" />
                        <DataGridCheckBoxColumn Header="Unique" Binding="{Binding IsUnique}" Width="60" />
                        <DataGridCheckBoxColumn Header="Clustered" Binding="{Binding IsClustered}" Width="70" />
                        <DataGridCheckBoxColumn Header="Constraint" Binding="{Binding BacksConstraint}" Width="75" />
                        <DataGridTextColumn Header="Key"
                                            Binding="{Binding Columns, Converter={StaticResource JoinList}}"
                                            Width="*" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Expander>

                  <Expander Header="Constraints" IsExpanded="True" Margin="0,0,0,8">
                    <DataGrid ItemsSource="{Binding Detail.Constraints}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              MaxHeight="200" FontFamily="Consolas" FontSize="12">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Constraint" Binding="{Binding Name}" Width="200" />
                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90" />
                        <DataGridTextColumn Header="Columns"
                                            Binding="{Binding Columns, Converter={StaticResource JoinList}}"
                                            Width="200" />
                        <DataGridTextColumn Header="References" Binding="{Binding ReferencedTable}" Width="150" />
                        <DataGridTextColumn Header="Check" Binding="{Binding CheckExpression}" Width="*" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Expander>

                  <Expander Header="Triggers" Margin="0,0,0,8">
                    <DataGrid ItemsSource="{Binding Detail.Triggers}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              MaxHeight="150" FontFamily="Consolas" FontSize="12">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Trigger" Binding="{Binding Name}" Width="220" />
                        <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="120" />
                        <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="*" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Expander>

                  <Expander Header="Storage and fragmentation" Margin="0,0,0,8"
                            ToolTip="{x:Static vm:InformixConcepts.Fragmentation}">
                    <DataGrid ItemsSource="{Binding Detail.Fragments}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              MaxHeight="180" FontFamily="Consolas" FontSize="12">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Strategy" Binding="{Binding Strategy}" Width="110" />
                        <DataGridTextColumn Header="Dbspace" Binding="{Binding DbSpace}" Width="150" />
                        <DataGridTextColumn Header="Expression" Binding="{Binding Expression}" Width="*" />
                      </DataGrid.Columns>
                    </DataGrid>
                  </Expander>

                  <Expander Header="What these Informix terms mean" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                      <TextBlock Text="Dbspace" FontWeight="SemiBold" Margin="0,4,0,0" />
                      <TextBlock Text="{x:Static vm:InformixConcepts.DbSpace}" TextWrapping="Wrap" />
                      <TextBlock Text="Extent" FontWeight="SemiBold" Margin="0,8,0,0" />
                      <TextBlock Text="{x:Static vm:InformixConcepts.Extent}" TextWrapping="Wrap" />
                      <TextBlock Text="Fragmentation" FontWeight="SemiBold" Margin="0,8,0,0" />
                      <TextBlock Text="{x:Static vm:InformixConcepts.Fragmentation}" TextWrapping="Wrap" />
                      <TextBlock Text="Lock mode" FontWeight="SemiBold" Margin="0,8,0,0" />
                      <TextBlock Text="{x:Static vm:InformixConcepts.LockMode}" TextWrapping="Wrap" />
                      <TextBlock Text="Statistics" FontWeight="SemiBold" Margin="0,8,0,0" />
                      <TextBlock Text="{x:Static vm:InformixConcepts.Statistics}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Expander>

                  <!-- PR-8.2 / PR-8.3: exactly what IMS asked the server. -->
                  <Expander Header="Catalogue queries behind this pane" Margin="0,0,0,8">
                    <TextBox Text="{Binding QueriesUsed, Mode=OneWay}"
                             IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Consolas" FontSize="11"
                             MaxHeight="240"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                  </Expander>

                </StackPanel>
              </ScrollViewer>

              <TextBlock Text="{Binding Error}" Foreground="#FFB3261E" Margin="10"
                         TextWrapping="Wrap" VerticalAlignment="Bottom" />
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
