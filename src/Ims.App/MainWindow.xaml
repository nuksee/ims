<Window x:Class="Ims.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ims.App"
        xmlns:vm="clr-namespace:Ims.App.ViewModels"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:ic="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        Title="Informix Management Studio"
        Icon="Resources/ims.ico"
        Height="820" Width="1320"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">

  <!--
    Layout follows SSMS (PR-8.1): registered servers on the left, a tabbed query
    editor on the right, results beneath it, status along the bottom. The users'
    existing muscle memory is an asset.
  -->

  <Window.Resources>
    <local:InformixValueConverter x:Key="ValueConverter" />
    <local:InformixValueIsNullConverter x:Key="IsNullConverter" />
    <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <local:CountToVisibilityConverter x:Key="CountToVisibility" />
    <local:NotNullToBooleanConverter x:Key="NotNullToBool" />
    <local:NullToVisibilityConverter x:Key="NullToVisibility" />
    <local:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
    <local:JoinListConverter x:Key="JoinList" />
    <local:EnvironmentBrushConverter x:Key="EnvironmentBrush" />
    <local:TransactionStateConverter x:Key="TransactionText" />
    <local:StatementOutcomeConverter x:Key="OutcomeText" />
    <local:UnknownIfNullConverter x:Key="UnknownIfNull" />
    <local:NotBooleanConverter x:Key="NotBool" />

    <!--
      Object detail (PR-2.4), shown in the tab strip beside the editors rather than
      in the results area below. Results and Messages describe the statement in the
      editor; an object's detail is not output of anything, it is a document of its
      own, so it is a tab of its own.

      Bound to a TableDetailViewModel, not to the ObjectDetailTabViewModel that owns
      it — the host sets Content to the inner view model, which is why every binding
      in here reads the same as it did as a TabItem.

      Every Informix-specific term carries its explanation on the tooltip (NFR-11):
      U2 will not know what a dbspace is.
    -->
    <DataTemplate x:Key="ObjectDetailTemplate" DataType="{x:Type vm:TableDetailViewModel}">
      <Grid>
        <TextBlock Text="Loading…"
                   Foreground="#FF5F6368" Margin="10"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Margin="10">

            <TextBlock Text="{Binding Title}" Style="{StaticResource HeadingText}" />

            <TextBlock Text="{Binding StorageSummary}" Margin="0,6,0,0"
                       TextWrapping="Wrap" Foreground="#FF3C4043" />

            <TextBlock Text="{Binding StatisticsSummary}" Margin="0,4,0,10"
                       TextWrapping="Wrap" Foreground="#FF3C4043"
                       ToolTip="{x:Static vm:InformixConcepts.Statistics}" />

            <Expander Header="Columns" IsExpanded="True" Margin="0,0,0,8">
              <DataGrid ItemsSource="{Binding Detail.Columns}"
                        AutoGenerateColumns="False" IsReadOnly="True"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                        MaxHeight="320" FontFamily="Consolas" FontSize="12">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="40" />
                  <DataGridTextColumn Header="Column" Binding="{Binding Name}" Width="200" />
                  <DataGridTextColumn Header="Type" Binding="{Binding TypeDescription}" Width="200" />
                  <DataGridCheckBoxColumn Header="Null?" Binding="{Binding IsNullable}" Width="55" />
                  <DataGridTextColumn Header="Default" Binding="{Binding DefaultValue}" Width="120" />
                  <!-- PR-8.2: the catalogue's own encoding, on show. -->
                  <DataGridTextColumn Header="coltype" Binding="{Binding RawColType}" Width="65" />
                  <DataGridTextColumn Header="collength" Binding="{Binding RawColLength}" Width="75" />
                </DataGrid.Columns>
              </DataGrid>
            </Expander>

            <Expander Header="Indexes" IsExpanded="True" Margin="0,0,0,8">
              <DataGrid ItemsSource="{Binding Detail.Indexes}"
                        AutoGenerateColumns="False" IsReadOnly="True"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                        MaxHeight="200" FontFamily="Consolas" FontSize="12">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Index" Binding="{Binding Name}" Width="200" />
                  <DataGridCheckBoxColumn Header="Unique" Binding="{Binding IsUnique}" Width="60" />
                  <DataGridCheckBoxColumn Header="Clustered" Binding="{Binding IsClustered}" Width="70" />
                  <DataGridCheckBoxColumn Header="Constraint" Binding="{Binding BacksConstraint}" Width="75" />
                  <DataGridTextColumn Header="Key"
                                      Binding="{Binding Columns, Converter={StaticResource JoinList}}"
                                      Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </Expander>

            <Expander Header="Constraints" IsExpanded="True" Margin="0,0,0,8">
              <DataGrid ItemsSource="{Binding Detail.Constraints}"
                        AutoGenerateColumns="False" IsReadOnly="True"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                        MaxHeight="200" FontFamily="Consolas" FontSize="12">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Constraint" Binding="{Binding Name}" Width="200" />
                  <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="90" />
                  <DataGridTextColumn Header="Columns"
                                      Binding="{Binding Columns, Converter={StaticResource JoinList}}"
                                      Width="200" />
                  <DataGridTextColumn Header="References" Binding="{Binding ReferencedTable}" Width="150" />
                  <DataGridTextColumn Header="Check" Binding="{Binding CheckExpression}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </Expander>

            <Expander Header="Triggers" Margin="0,0,0,8">
              <DataGrid ItemsSource="{Binding Detail.Triggers}"
                        AutoGenerateColumns="False" IsReadOnly="True"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                        MaxHeight="150" FontFamily="Consolas" FontSize="12">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Trigger" Binding="{Binding Name}" Width="220" />
                  <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="120" />
                  <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </Expander>

            <Expander Header="Storage and fragmentation" Margin="0,0,0,8"
                      ToolTip="{x:Static vm:InformixConcepts.Fragmentation}">
              <DataGrid ItemsSource="{Binding Detail.Fragments}"
                        AutoGenerateColumns="False" IsReadOnly="True"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                        MaxHeight="180" FontFamily="Consolas" FontSize="12">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Strategy" Binding="{Binding Strategy}" Width="110" />
                  <DataGridTextColumn Header="Dbspace" Binding="{Binding DbSpace}" Width="150" />
                  <DataGridTextColumn Header="Expression" Binding="{Binding Expression}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </Expander>

            <Expander Header="What these Informix terms mean" Margin="0,0,0,8">
              <StackPanel Margin="6">
                <TextBlock Text="Dbspace" FontWeight="SemiBold" Margin="0,4,0,0" />
                <TextBlock Text="{x:Static vm:InformixConcepts.DbSpace}" TextWrapping="Wrap" />
                <TextBlock Text="Extent" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="{x:Static vm:InformixConcepts.Extent}" TextWrapping="Wrap" />
                <TextBlock Text="Fragmentation" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="{x:Static vm:InformixConcepts.Fragmentation}" TextWrapping="Wrap" />
                <TextBlock Text="Lock mode" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="{x:Static vm:InformixConcepts.LockMode}" TextWrapping="Wrap" />
                <TextBlock Text="Statistics" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="{x:Static vm:InformixConcepts.Statistics}" TextWrapping="Wrap" />
              </StackPanel>
            </Expander>

            <!-- PR-8.2 / PR-8.3: exactly what IMS asked the server. -->
            <Expander Header="Catalogue queries behind this pane" Margin="0,0,0,8">
              <TextBox Text="{Binding QueriesUsed, Mode=OneWay}"
                       IsReadOnly="True" AcceptsReturn="True"
                       FontFamily="Consolas" FontSize="11"
                       MaxHeight="240"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto" />
            </Expander>

          </StackPanel>
        </ScrollViewer>

        <TextBlock Text="{Binding Error}" Foreground="#FFB3261E" Margin="10"
                   TextWrapping="Wrap" VerticalAlignment="Top" />
      </Grid>
    </DataTemplate>

    <!--
      The session monitor (PR-5.1 to PR-5.7), a tab of its own beside the editors.

      Three bands: the instance's own indicators across the top (PR-5.6), the session
      list, and the selected session's detail beneath it. The list has a fixed set of
      columns and a bounded row count, so it is a static DataGrid like the object
      detail's — not the dynamic column building the results grid does, which exists
      for a cursor whose shape is unknown until it runs.

      Nothing here signals state by colour alone (NFR-8). "YOU" is a word, a blocked
      session names its blocker in text, and the fidelity of the blocking picture is a
      sentence rather than an icon.
    -->
    <DataTemplate x:Key="SessionMonitorTemplate" DataType="{x:Type vm:SessionMonitorTabViewModel}">
      <Grid Margin="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="120" />
          <RowDefinition Height="4" />
          <RowDefinition Height="Auto" MaxHeight="300" />
        </Grid.RowDefinitions>

        <!--
          PR-5.6. Every figure may be absent, because each comes from its own query and
          any one of them can fail on a server shaped differently — so each reads
          "Unknown" rather than blank, which would be indistinguishable from zero.
        -->
        <Border Grid.Row="0" Background="#FFF6F7F9" BorderBrush="#FFE0E0E0"
                BorderThickness="1" Padding="8,6" Margin="0,0,0,8"
                Visibility="{Binding Indicators, Converter={StaticResource NotNullToVisibility}}">
          <WrapPanel AutomationProperties.Name="Instance indicators">
            <TextBlock Text="Mode" FontWeight="SemiBold" Margin="0,0,4,0" />
            <TextBlock Text="{Binding Indicators.Mode, Converter={StaticResource UnknownIfNull}}"
                       Margin="0,0,16,0" />

            <TextBlock Text="Up" FontWeight="SemiBold" Margin="0,0,4,0"
                       ToolTip="{x:Static vm:InformixConcepts.Uptime}" />
            <TextBlock Text="{Binding Indicators.Uptime, Converter={StaticResource UnknownIfNull}}"
                       Margin="0,0,16,0" />

            <TextBlock Text="Sessions" FontWeight="SemiBold" Margin="0,0,4,0"
                       ToolTip="{x:Static vm:InformixConcepts.Session}" />
            <TextBlock Text="{Binding Indicators.SessionCount, Converter={StaticResource UnknownIfNull}}"
                       Margin="0,0,16,0" />

            <TextBlock Text="Read cache" FontWeight="SemiBold" Margin="0,0,4,0"
                       ToolTip="{x:Static vm:InformixConcepts.BufferEfficiency}" />
            <TextBlock Margin="0,0,16,0"
                       Text="{Binding Indicators.ReadCachePercent,
                              Converter={StaticResource UnknownIfNull}, ConverterParameter='{}{0:N2}%'}" />

            <TextBlock Text="Write cache" FontWeight="SemiBold" Margin="0,0,4,0"
                       ToolTip="{x:Static vm:InformixConcepts.BufferEfficiency}" />
            <TextBlock Margin="0,0,16,0"
                       Text="{Binding Indicators.WriteCachePercent,
                              Converter={StaticResource UnknownIfNull}, ConverterParameter='{}{0:N2}%'}" />

            <TextBlock Text="Last checkpoint" FontWeight="SemiBold" Margin="0,0,4,0"
                       ToolTip="{x:Static vm:InformixConcepts.Checkpoint}" />
            <TextBlock Margin="0,0,16,0"
                       Text="{Binding Indicators.LastCheckpoint,
                              Converter={StaticResource UnknownIfNull}, ConverterParameter='{}{0:HH:mm:ss}'}" />
          </WrapPanel>
        </Border>

        <!-- Refresh control (PR-5.5) and the filter (PR-5.4). -->
        <DockPanel Grid.Row="1" Margin="0,0,0,6">
          <!--
            Disabled while a read is in flight. RefreshAsync already returns early in that
            case, so this is not what prevents a double read — it is what stops the button
            looking available when pressing it would do nothing.
          -->
          <Button DockPanel.Dock="Left" Command="{Binding RefreshCommand}"
                  IsEnabled="{Binding IsReading,
                              Converter={StaticResource NotBool}, FallbackValue=True}"
                  Padding="6,2" Margin="0,0,6,0"
                  ToolTip="Read the session list now"
                  AutomationProperties.Name="Refresh the session list">
            <StackPanel Orientation="Horizontal">
              <ic:SymbolIcon Symbol="ArrowClockwise" FontSize="13" />
              <AccessText Text="_Refresh" Margin="4,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!--
            Manual is the default and it is a real choice, not an off switch: PR-5.5
            makes it the default precisely so IMS asks the server nothing until told to.
          -->
          <TextBlock DockPanel.Dock="Left" Text="Refresh" VerticalAlignment="Center"
                     Margin="6,0,4,0" />
          <ComboBox DockPanel.Dock="Left" Width="110" Margin="0,0,12,0"
                    SelectedIndex="0"
                    SelectionChanged="OnRefreshIntervalChanged"
                    AutomationProperties.Name="Refresh interval">
            <ComboBoxItem Content="Manually" Tag="0" />
            <ComboBoxItem Content="Every 5s" Tag="5" />
            <ComboBoxItem Content="Every 10s" Tag="10" />
            <ComboBoxItem Content="Every 30s" Tag="30" />
            <ComboBoxItem Content="Every minute" Tag="60" />
            <ComboBoxItem Content="Every 5 minutes" Tag="300" />
          </ComboBox>

          <CheckBox DockPanel.Dock="Right" Content="Hide system sessions"
                    IsChecked="{Binding HideSystemSessions}"
                    VerticalAlignment="Center" Margin="8,0,0,0"
                    AutomationProperties.Name="Hide system sessions" />

          <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                   MinWidth="160" Margin="0,0,8,0" Padding="3,2"
                   ToolTip="Filter by user, host, application, state or session id"
                   AutomationProperties.Name="Filter sessions" />
        </DockPanel>

        <!-- When the list was read, and what IMS could establish about blocking. -->
        <DockPanel Grid.Row="2" Margin="0,0,0,6">
          <!--
            While a read is in flight this replaces the timestamp rather than sitting beside
            it: the two say the same thing at different moments, and "Read at 14:02:11" next
            to "Reading…" invites the question of which is true now.

            A word, not a spinner (NFR-8). Because these queries are bounded and small, a
            refresh usually returns too fast to see — so the point of this is the case where
            it does not: a monitor queueing behind a tree expansion, or a syslocks query
            running to its 10s timeout, which is a measured outcome on this estate rather than
            a hypothetical.
          -->
          <TextBlock DockPanel.Dock="Right" Text="Reading…"
                     Foreground="#FF5F6368" FontStyle="Italic"
                     Visibility="{Binding IsReading, Converter={StaticResource BoolToVisibility}}"
                     AutomationProperties.Name="Reading the session list" />
          <TextBlock DockPanel.Dock="Right" Text="{Binding ReadAtLabel}"
                     Foreground="#FF5F6368"
                     Visibility="{Binding IsReading,
                                  Converter={StaticResource BoolToVisibility},
                                  ConverterParameter=Invert}"
                     AutomationProperties.Name="When the list was read" />
          <TextBlock Text="{Binding FidelityLabel}" TextWrapping="Wrap"
                     Foreground="#FF3C4043"
                     ToolTip="{x:Static vm:InformixConcepts.Lock}"
                     AutomationProperties.Name="Blocking summary" />
        </DockPanel>

        <!--
          The session list (PR-5.1). Sorting is the DataGrid's own, over the fetched
          rows — a session list is small, so unlike the object tree there is nothing to
          gain by pushing it back to the server, and re-querying sysmaster per keystroke
          is exactly the load PR-6.4 rules out.
        -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Sessions}"
                  SelectedItem="{Binding SelectedSession}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  CanUserSortColumns="True"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  ClipboardCopyMode="IncludeHeader"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  FontFamily="Consolas" FontSize="12"
                  AutomationProperties.Name="Session list">
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <!--
                The tint is decoration. The "You" column carries the meaning, so this
                still reads correctly in monochrome or to a screen reader (NFR-8).
              -->
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMine}" Value="True">
                  <Setter Property="Background" Value="#FFEEF6FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                  <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="You" Binding="{Binding MineLabel}" Width="40"
                                SortMemberPath="IsMine" />
            <DataGridTextColumn Header="Session" Binding="{Binding Sid}" Width="70" />
            <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="120" />
            <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="140" />
            <DataGridTextColumn Header="Application" Binding="{Binding Application}" Width="140" />
            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="160" />
            <!-- PR-5.3: the blocker, named, in the row that is waiting. -->
            <DataGridTextColumn Header="Blocked by" Binding="{Binding BlockedByLabel}" Width="90"
                                SortMemberPath="IsBlocked" />
            <DataGridTextColumn Header="Connected" Width="140"
                                Binding="{Binding ConnectedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" />
          </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="4" Height="4" HorizontalAlignment="Stretch"
                      Background="#FFE0E0E0" />

        <!-- The selected session's detail (PR-5.2), and the queries behind it (PR-8.2). -->
        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="{Binding Notice}" Foreground="#FFB3261E"
                       TextWrapping="Wrap" Margin="0,4,0,4"
                       Visibility="{Binding Notice, Converter={StaticResource NotNullToVisibility}}"
                       AutomationProperties.Name="Notice" />

            <!--
              Reading takes precedence over the prompt: Detail is null while a read is in
              flight too, so without this, selecting a session would show "Select a session"
              for as long as the read took — which on this estate can be the ten seconds a
              syslocks query spends reaching its timeout.
            -->
            <TextBlock Text="Reading session detail…"
                       Foreground="#FF5F6368" FontStyle="Italic" Margin="0,6,0,0"
                       Visibility="{Binding IsReadingDetail,
                                    Converter={StaticResource BoolToVisibility}}"
                       AutomationProperties.Name="Reading session detail" />

            <TextBlock Text="Select a session to see its locks and what it is running."
                       Foreground="#FF5F6368" Margin="0,6,0,0"
                       Visibility="{Binding ShowSelectSessionPrompt,
                                    Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Visibility="{Binding Detail, Converter={StaticResource NotNullToVisibility}}">

              <!-- PR-5.7: only drawn where more than two sessions are involved. -->
              <Border Background="#FFFFF4CE" BorderBrush="#FFE0C060" BorderThickness="1"
                      Padding="8,5" Margin="0,4,0,8"
                      Visibility="{Binding HasChains, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <TextBlock Text="⚠ Lock wait chain" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ChainsLabel}" FontFamily="Consolas"
                             TextWrapping="Wrap" Margin="0,3,0,0"
                             AutomationProperties.Name="Lock wait chain" />
                  <TextBlock Text="Read right to left: each session is waiting on the one after it."
                             Foreground="#FF5F6368" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
              </Border>

              <Expander Header="What this session is running" IsExpanded="True" Margin="0,0,0,8">
                <StackPanel>
                  <TextBlock Text="{Binding Detail.CurrentSql}" FontFamily="Consolas" FontSize="12"
                             TextWrapping="Wrap" Margin="4"
                             AutomationProperties.Name="Current statement" />
                  <TextBlock Text="Only the first 2000 characters are shown."
                             Foreground="#FF5F6368" Margin="4,0,0,0"
                             Visibility="{Binding Detail.CurrentSqlTruncated,
                                          Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
              </Expander>

              <Expander Header="Locks held" IsExpanded="True" Margin="0,0,0,8">
                <DataGrid ItemsSource="{Binding Detail.LocksHeld}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          ClipboardCopyMode="IncludeHeader"
                          MaxHeight="180" FontFamily="Consolas" FontSize="12"
                          AutomationProperties.Name="Locks held">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Object" Binding="{Binding Resource}" Width="220" />
                    <DataGridTextColumn Header="Mode" Binding="{Binding LockType}" Width="140" />
                    <!-- PR-8.2: the server's own code, on show. -->
                    <DataGridTextColumn Header="type" Binding="{Binding RawLockType}" Width="55" />
                    <DataGridTextColumn Header="Row" Binding="{Binding RowId}" Width="90" />
                    <DataGridTextColumn Header="Index" Binding="{Binding KeyNumber}" Width="55" />
                  </DataGrid.Columns>
                </DataGrid>
              </Expander>

              <Expander Header="Resource use" Margin="0,0,0,8">
                <StackPanel Margin="4"
                            Visibility="{Binding Detail.Resources,
                                         Converter={StaticResource NotNullToVisibility}}">
                  <TextBlock Text="{Binding Detail.Resources.MemoryUsedBytes,
                                    StringFormat='Memory in use: {0:N0} bytes'}" />
                  <TextBlock Text="{Binding Detail.Resources.MemoryTotalBytes,
                                    StringFormat='Memory allocated: {0:N0} bytes'}" />
                </StackPanel>
              </Expander>

              <!--
                NFR-11. U2 will not know what a latch is, and the session monitor is
                where Informix's vocabulary arrives all at once.
              -->
              <Expander Header="What these Informix terms mean" Margin="0,0,0,8">
                <StackPanel Margin="6">
                  <TextBlock Text="Session" FontWeight="SemiBold" Margin="0,4,0,0" />
                  <TextBlock Text="{x:Static vm:InformixConcepts.Session}" TextWrapping="Wrap" />
                  <TextBlock Text="Lock" FontWeight="SemiBold" Margin="0,8,0,0" />
                  <TextBlock Text="{x:Static vm:InformixConcepts.Lock}" TextWrapping="Wrap" />
                  <TextBlock Text="Latch" FontWeight="SemiBold" Margin="0,8,0,0" />
                  <TextBlock Text="{x:Static vm:InformixConcepts.Latch}" TextWrapping="Wrap" />
                  <TextBlock Text="Checkpoint" FontWeight="SemiBold" Margin="0,8,0,0" />
                  <TextBlock Text="{x:Static vm:InformixConcepts.Checkpoint}" TextWrapping="Wrap" />
                  <TextBlock Text="Buffer efficiency" FontWeight="SemiBold" Margin="0,8,0,0" />
                  <TextBlock Text="{x:Static vm:InformixConcepts.BufferEfficiency}" TextWrapping="Wrap" />
                  <TextBlock Text="Session id and process id" FontWeight="SemiBold" Margin="0,8,0,0" />
                  <TextBlock Text="{x:Static vm:InformixConcepts.SessionVersusProcess}" TextWrapping="Wrap" />
                </StackPanel>
              </Expander>
            </StackPanel>

            <!--
              PR-8.2 and PR-8.3 together: the queries IMS sent, and beside each the
              onstat command that answers the same question. Formatted as SQL comments
              so the whole block can be taken to an editor tab and run.
            -->
            <Expander Header="Queries behind this pane, and their onstat equivalents"
                      Margin="0,0,0,8">
              <DockPanel>
                <Button DockPanel.Dock="Top" HorizontalAlignment="Left"
                        Content="Open in a new editor tab" Padding="6,2" Margin="0,0,0,4"
                        Click="OnOpenSessionQueries"
                        AutomationProperties.Name="Open the session queries in an editor tab" />
                <TextBox Text="{Binding QueryText, Mode=OneWay}"
                         IsReadOnly="True" AcceptsReturn="True"
                         FontFamily="Consolas" FontSize="11"
                         MaxHeight="240"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Queries behind this pane" />
              </DockPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <!--
    PR-3.10: execute, cancel and new tab from the keyboard, using the gestures
    SSMS users already have in their fingers (PR-8.1).

    These are RoutedUICommands declared in code-behind, not {Binding} to view-model
    commands. The first attempt bound to ExecuteCommand on the window's DataContext,
    which is MainViewModel — but that command lives on EditorTabViewModel, so the
    binding silently resolved to nothing and F5 did exactly that. A routed command
    also reaches the handler when focus is inside the editor, which a KeyBinding on
    the window does not reliably do.
  -->

  <DockPanel>

    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New query" Command="{x:Static local:MainWindow.NewQueryCommand}" />
        <MenuItem Header="_Open…" Command="{x:Static local:MainWindow.OpenFileCommand}" />
        <MenuItem Header="_Save" Command="{x:Static local:MainWindow.SaveFileCommand}" />
        <MenuItem Header="Save _as…" Click="OnSaveFileAs" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Query">
        <!--
          IsEnabled mirrors the toolbar's. EditorTabViewModel.CanExecute was computed
          and bound nowhere until the toolbar arrived, so these items stayed lit on a
          disconnected tab and did nothing when clicked. Menu and toolbar disagreeing
          about whether Execute is available would read as a bug in one of them.
        -->
        <MenuItem Header="_Execute" Command="{x:Static local:MainWindow.ExecuteCommand}"
                  IsEnabled="{Binding SelectedTab.CanExecute, FallbackValue=False}" />
        <MenuItem Header="Execute _selection" Command="{x:Static local:MainWindow.ExecuteSelectionCommand}"
                  IsEnabled="{Binding SelectedTab.CanExecute, FallbackValue=False}" />
        <MenuItem Header="_Cancel" Command="{x:Static local:MainWindow.CancelExecutionCommand}"
                  IsEnabled="{Binding SelectedTab.IsExecuting, FallbackValue=False}" />
        <Separator />
        <!-- Listed so the gesture is discoverable; PR-3.2 is not much use unfound. -->
        <MenuItem Header="Complete _word" Command="{x:Static local:MainWindow.CompleteCommand}" />
        <Separator />
        <MenuItem Header="Commit" Click="OnCommit"
                  IsEnabled="{Binding SelectedTab.Session,
                              Converter={StaticResource NotNullToBool}, FallbackValue=False}" />
        <MenuItem Header="Roll back" Click="OnRollback"
                  IsEnabled="{Binding SelectedTab.Session,
                              Converter={StaticResource NotNullToBool}, FallbackValue=False}" />
      </MenuItem>
      <MenuItem Header="_Connection">
        <MenuItem Header="_New connection…" Click="OnNewConnection" />
        <MenuItem Header="_Edit selected…" Click="OnEditConnection" />
        <MenuItem Header="_Remove selected" Click="OnRemoveConnection" />
      </MenuItem>
      <!--
        Instance-scoped like Connection, so it sits beside it rather than under
        Results, which is where a statement's own output lives.
      -->
      <MenuItem Header="_Sessions">
        <MenuItem Header="_Session monitor" Command="{x:Static local:MainWindow.SessionMonitorCommand}" />
      </MenuItem>
      <MenuItem Header="_Results">
        <MenuItem Header="Export to _CSV…" Click="OnExportCsv" />
        <MenuItem Header="Export to _tab-delimited…" Click="OnExportTsv" />
        <MenuItem Header="Export to _JSON…" Click="OnExportJson" />
        <MenuItem Header="Export to _Excel…" Click="OnExportExcel" />
        <Separator />
        <MenuItem Header="Copy selection" Click="OnCopySelection" />
        <MenuItem Header="Fetch more rows" Click="OnFetchMore" />
        <Separator />
        <MenuItem Header="C_lear results" Command="{x:Static local:MainWindow.ClearResultsCommand}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Contents" Command="{x:Static local:MainWindow.HelpContentsCommand}" />
        <Separator />
        <MenuItem Header="Query _history…" Click="OnShowHistory" />
        <MenuItem Header="_About IMS" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="CsdkStatusText" AutomationProperties.Name="Client SDK status" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding SelectedTab.TargetLabel, FallbackValue='Not connected'}"
                   AutomationProperties.Name="Target instance" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <!-- PR-3.7: transaction state is visible at all times, in words. -->
        <TextBlock Text="{Binding SelectedTab.TransactionState, Converter={StaticResource TransactionText}}"
                   AutomationProperties.Name="Transaction state" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Text="{Binding StatusText}" AutomationProperties.Name="Status" />
      </StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="290" MinWidth="200" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" Margin="6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="120" MaxHeight="320" />
          <RowDefinition Height="4" />
          <RowDefinition Height="*" MinHeight="140" />
        </Grid.RowDefinitions>

      <!-- Instance list (PR-1.2) -->
      <DockPanel Grid.Row="0">
        <TextBox DockPanel.Dock="Top"
                 Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,6" Padding="4,3"
                 AutomationProperties.Name="Search connections" />

        <ListBox x:Name="ConnectionList"
                 ItemsSource="{Binding Connections}"
                 SelectedItem="{Binding SelectedConnection}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="OnConnect"
                 AutomationProperties.Name="Saved connections">
          <!-- The menu is a resource, not inline in the Setter below. A Click
               handler on a MenuItem inside a Style setter cannot be wired up as an
               instance event: the XAML compiler emits AddHandler against the wrong
               target type and the window throws on load. As a keyed resource the
               items are ordinary named elements again, and the handlers bind. -->
          <ListBox.Resources>
            <ContextMenu x:Key="ConnectionContextMenu">
              <MenuItem Header="C_onnect" Click="OnConnect"
                        Visibility="{Binding PlacementTarget.DataContext.IsConnected,
                                     RelativeSource={RelativeSource Self},
                                     Converter={StaticResource BoolToVisibility},
                                     ConverterParameter=Invert}" />
              <MenuItem Header="_Disconnect" Click="OnDisconnect"
                        Visibility="{Binding PlacementTarget.DataContext.IsConnected,
                                     RelativeSource={RelativeSource Self},
                                     Converter={StaticResource BoolToVisibility}}" />
              <Separator />
              <MenuItem Header="_Edit…" Click="OnEditConnection" />
              <MenuItem Header="_Remove" Click="OnRemoveConnection" />
            </ContextMenu>
          </ListBox.Resources>

          <!-- Right-clicking a row selects it first, so the menu always acts on
               the row under the cursor rather than the previous selection. -->
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnConnectionRightClick" />
              <Setter Property="ContextMenu" Value="{StaticResource ConnectionContextMenu}" />
            </Style>
          </ListBox.ItemContainerStyle>

          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="2,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Elided, not wrapped. The badge beside it is the one thing in this
                     row that must never be cut off (PR-1.5), so a long connection
                     name has to give way to it rather than push it off the edge. -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DisplayName}" />

                <!-- PR-1.5 and NFR-8: the word is the signal, the colour merely
                     reinforces it. This must be unmistakable to someone who cannot
                     tell red from green. -->
                <Border Grid.Row="0" Grid.Column="1"
                        Background="{Binding Environment, Converter={StaticResource EnvironmentBrush}}"
                        CornerRadius="3" Padding="5,1" Margin="6,0,0,0">
                  <TextBlock Text="{Binding EnvironmentLabel}"
                             Foreground="White" FontSize="10" FontWeight="Bold"
                             AutomationProperties.Name="Environment" />
                </Border>

                <!-- A database and host name runs long, and as one unwrapped line it
                     set the whole row's width — widening the item past the list's
                     viewport and carrying the badge in column 1 off the right edge
                     with it. Elided, so the row is only ever as wide as the list. -->
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding Detail}" FontSize="11" Foreground="#FF5F6368"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Detail}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                    Background="#FFE0E0E0" />

      <!--
        Object browser (PR-2.1 to PR-2.3, PR-2.7).

        Children load on first expansion (PR-2.2), the filter goes into the
        catalogue query rather than being applied to a fetched list (PR-2.3,
        NFR-2), and the context menu exposes the query behind whatever is
        selected (PR-8.2).
      -->
      <DockPanel Grid.Row="2">
        <TextBlock DockPanel.Dock="Top" Text="Objects" FontWeight="SemiBold" Margin="0,0,0,4" />

        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBox Grid.Column="0" Padding="4,3"
                   Text="{Binding ObjectTree.Filter, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                   IsEnabled="{Binding ObjectTree, Converter={StaticResource NotNullToBool}}"
                   AutomationProperties.Name="Filter objects by name" />

          <Button Grid.Column="1" Content="⟳" Margin="4,0,0,0" Padding="7,2"
                  ToolTip="Refresh the selected node"
                  Click="OnRefreshTreeNode"
                  AutomationProperties.Name="Refresh" />
        </Grid>

        <CheckBox DockPanel.Dock="Bottom" Margin="0,4,0,0"
                  Content="Show system objects"
                  IsChecked="{Binding ObjectTree.IncludeSystemObjects}"
                  IsEnabled="{Binding ObjectTree, Converter={StaticResource NotNullToBool}}"
                  ToolTip="Informix keeps its own catalogue at tabid 1-99." />

        <TextBlock DockPanel.Dock="Bottom" Margin="0,4,0,0" TextWrapping="Wrap"
                   Foreground="#FF5F6368" FontSize="11"
                   Text="Connect to an instance to browse its objects."
                   Visibility="{Binding ObjectTree, Converter={StaticResource NullToVisibility}}" />

        <TreeView x:Name="ObjectTreeView"
                  ItemsSource="{Binding ObjectTree.Roots}"
                  SelectedItemChanged="OnTreeSelectionChanged"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  AutomationProperties.Name="Database objects">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <!-- PR-2.2: children are fetched on first expansion, never up front. -->
              <EventSetter Event="Expanded" Handler="OnTreeItemExpanded" />
              <!--
                Right-click selects the node it lands on. A TreeViewItem does not do
                this on its own, so the menu below — which acts on the *selection* —
                was acting on whatever had last been left-clicked. Right-clicking a
                table and choosing "Show detail" would open a different table's.
              -->
              <EventSetter Event="PreviewMouseRightButtonDown"
                           Handler="OnTreeItemRightButtonDown" />
            </Style>
          </TreeView.ItemContainerStyle>

          <TreeView.ContextMenu>
            <!--
              Actions that do not apply to the selection are disabled rather than
              offered and then refused. Being told "no" after clicking teaches
              nothing; a greyed item shows what the selection is.
            -->
            <ContextMenu DataContext="{Binding PlacementTarget.DataContext,
                                       RelativeSource={RelativeSource Self}}">
              <MenuItem Header="_SELECT first 100 rows"
                        Click="OnSelectFirstRows"
                        IsEnabled="{Binding ObjectTree.CanSelectRows, FallbackValue=False}" />
              <MenuItem Header="Show _detail"
                        Click="OnShowObjectDetail"
                        IsEnabled="{Binding ObjectTree.CanSelectRows, FallbackValue=False}" />
              <MenuItem Header="Script as CRE_ATE"
                        Click="OnScriptObject"
                        IsEnabled="{Binding ObjectTree.CanScriptSelection, FallbackValue=False}" />
              <MenuItem Header="_Copy qualified name"
                        Click="OnCopyQualifiedName"
                        IsEnabled="{Binding ObjectTree.HasSelectedObject, FallbackValue=False}" />
              <Separator />
              <MenuItem Header="Show the catalogue _query…" Click="OnShowCatalogQuery" />
              <MenuItem Header="_Refresh" Click="OnRefreshTreeNode" />
            </ContextMenu>
          </TreeView.ContextMenu>

          <TreeView.Resources>
            <HierarchicalDataTemplate DataType="{x:Type vm:ObjectFolderNodeViewModel}"
                                      ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" Margin="0,0,5,0" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="  (loading…)" Foreground="#FF5F6368"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </HierarchicalDataTemplate>

            <DataTemplate DataType="{x:Type vm:SchemaObjectNodeViewModel}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" Margin="0,0,5,0" />
                <TextBlock Text="{Binding Name}" />
                <TextBlock Text="{Binding Detail, StringFormat='  {0}'}"
                           Foreground="#FF5F6368" FontSize="11" />
              </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PlaceholderNodeViewModel}">
              <TextBlock Text="{Binding Name}" Foreground="#FF5F6368" FontStyle="Italic" />
            </DataTemplate>
          </TreeView.Resources>
        </TreeView>
      </DockPanel>
      </Grid>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                    Background="#FFE0E0E0" />

      <!-- Editor and results -->
      <!--
        Rows 2 and 3 are named because a detail tab gives them up. Collapsing the
        splitter and the results TabControl is not enough on its own: the row keeps
        its star share and its MinHeight either way, so the pane went invisible and
        left its space behind as a blank band under the detail. Code-behind zeroes
        the two heights with it and restores them for an editor tab — the star share
        rather than a measured height, so a splitter the user has dragged keeps the
        proportion they set.
      -->
      <Grid Grid.Column="2" Margin="0,6,6,6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="120" />
          <RowDefinition x:Name="ResultsSplitterRow" Height="4" />
          <RowDefinition x:Name="ResultsRow" Height="*" MinHeight="120" />
        </Grid.RowDefinitions>

        <!--
          Query toolbar (PR-8.1). SSMS puts one here, above the tab strip, and until
          now every query action in IMS was reachable only from the menu bar or by
          knowing its gesture — Execute included.

          A Border and a DockPanel rather than a ToolBar, for two reasons. ToolBar
          replaces each child Button's template with its own chrome, which fights the
          inline padding this window uses everywhere else. More seriously, ToolBar
          moves buttons it cannot fit into an overflow popup, and this toolbar sits in
          a column whose width the user drags: Execute would disappear mid-drag, and
          AutomationProperties on an overflowed item is not reachable, so NFR-8 would
          go with it. A DockPanel clips instead — visible and predictable. That is the
          same failure the tab strip below had to be rebuilt around.

          The leftmost element is a read-only target label, not SSMS's database
          dropdown: ConnectionDescriptor.Database is fixed for the life of a
          connection and there is no per-session switch to offer. Parse and the
          execution-plan buttons are absent for a harder reason — there is no SQL
          parser here, and PR-6.2 says IMS sends no statement the user did not type.
        -->
        <Border Grid.Row="0" Margin="0,0,0,4" Padding="4,3"
                Background="#FFF5F5F5" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1"
                KeyboardNavigation.TabNavigation="Continue">
          <Border.Resources>
            <!--
              Scoped to this toolbar rather than App.xaml: an implicit Button style up
              there would repad every dialog in the app, and a keyed one would mean
              repeating Style= on all seventeen buttons for no reuse. Deliberately no
              ControlTemplate — keeping stock WPF chrome is the whole reason this is
              not a ToolBar.
            -->
            <Style TargetType="Button">
              <Setter Property="Padding" Value="6,2" />
              <Setter Property="Margin" Value="2,0,0,0" />
              <Setter Property="MinWidth" Value="30" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="VerticalAlignment" Value="Center" />
              <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>

            <!-- Separator draws a horizontal rule; in a horizontal band the divider
                 has to be a vertical one, so it is drawn directly. -->
            <!-- SymbolIcon takes its glyph size from FontSize. Set once here rather
                 than on each of the fourteen icons, so they cannot drift apart. -->
            <Style TargetType="ic:SymbolIcon">
              <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="ToolbarDivider" TargetType="Border">
              <Setter Property="Width" Value="1" />
              <Setter Property="Margin" Value="6,2" />
              <Setter Property="Background" Value="#FFD0D0D0" />
            </Style>
          </Border.Resources>

          <!--
            SelectedTab is an ITabViewModel, because object detail tabs share this
            strip. Every editor-only binding below therefore carries a FallbackValue:
            on a detail tab the path does not resolve, and the fallback is what
            disables the button instead of leaving it live and doing nothing.
          -->
          <!--
            Two columns rather than one DockPanel with a right-docked group. The
            actions column is Auto and clips when the user drags the splitter narrow;
            the trailing column is Auto too, so History and Help keep their place at
            the right edge instead of depending on how much room the left group left
            over. A star column between them would only move the clipping.
          -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
              The button run lives in a scroller with its bars hidden, which is the
              only thing that lets the star column actually shrink: a DockPanel
              measures at its full desired width regardless of the space on offer, so
              the run pushed History and Help clean off the window instead of
              clipping — measured at 260px past the right edge. ClipToBounds alone
              does not fix it, because it clips the drawing and not the measure.

              Same trick, and the same reason, as the tab strip below.
            -->
            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          Focusable="False">
            <DockPanel LastChildFill="False">

            <!-- Which instance this tab runs against (PR-1.6). Read-only. -->
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="4,0,2,0"
                       MaxWidth="240" TextTrimming="CharacterEllipsis"
                       Text="{Binding SelectedTab.TargetLabel, FallbackValue='Not connected'}"
                       ToolTip="{Binding SelectedTab.TargetLabel, FallbackValue='Not connected'}"
                       AutomationProperties.Name="Target instance" />
            <!-- PlugConnectedCheckmark rather than the plain PlugConnected: beside
                 PlugDisconnected at this size the two plain plugs were a coin toss,
                 and the pair has to be told apart at a glance. -->
            <Button DockPanel.Dock="Left" Click="OnConnect"
                    ToolTip="Connect the selected instance"
                    AutomationProperties.Name="Connect">
              <ic:SymbolIcon Symbol="PlugConnectedCheckmark" />
            </Button>
            <Button DockPanel.Dock="Left" Click="OnDisconnect"
                    ToolTip="Disconnect the selected instance"
                    AutomationProperties.Name="Disconnect">
              <ic:SymbolIcon Symbol="PlugDisconnected" />
            </Button>

            <!-- Instance-scoped, so it belongs with Connect rather than with the query
                 actions after the divider (PR-5.1). -->
            <Button DockPanel.Dock="Left"
                    Command="{x:Static local:MainWindow.SessionMonitorCommand}"
                    ToolTip="Session monitor — who is connected and what is blocked (Ctrl+Alt+S)"
                    AutomationProperties.Name="Session monitor">
              <ic:SymbolIcon Symbol="Pulse" />
            </Button>

            <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarDivider}" />

            <Button DockPanel.Dock="Left"
                    Command="{x:Static local:MainWindow.NewQueryCommand}"
                    ToolTip="New query tab (Ctrl+N)"
                    AutomationProperties.Name="New query">
              <ic:SymbolIcon Symbol="DocumentAdd" />
            </Button>
            <Button DockPanel.Dock="Left"
                    Command="{x:Static local:MainWindow.OpenFileCommand}"
                    ToolTip="Open a .sql file (Ctrl+O)"
                    AutomationProperties.Name="Open file">
              <ic:SymbolIcon Symbol="FolderOpen" />
            </Button>
            <Button DockPanel.Dock="Left"
                    Command="{x:Static local:MainWindow.SaveFileCommand}"
                    ToolTip="Save this tab (Ctrl+S)"
                    AutomationProperties.Name="Save">
              <ic:SymbolIcon Symbol="Save" />
            </Button>

            <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarDivider}" />

            <!--
              Execute and Cancel share one cell rather than sitting side by side, so
              the strip does not reflow the instant a run starts and slide every
              button to its right out from under the cursor.

              IsEnabled comes from EditorTabViewModel.CanExecute, which until now was
              computed and bound to nothing: Execute on a disconnected tab was a
              silent no-op. The Query menu binds the same property, so the two agree.

              The green is decoration. The icon shape and the word carry the meaning,
              which is what NFR-8 asks for.
            -->
            <Grid DockPanel.Dock="Left" Margin="2,0,0,0">
              <Button Margin="0"
                      Command="{x:Static local:MainWindow.ExecuteCommand}"
                      IsEnabled="{Binding SelectedTab.CanExecute, FallbackValue=False}"
                      Visibility="{Binding SelectedTab.IsExecuting,
                                   Converter={StaticResource BoolToVisibility},
                                   ConverterParameter=Invert, FallbackValue=Visible}"
                      ToolTip="Run the script, or the selection if there is one (F5)"
                      AutomationProperties.Name="Execute">
                <!-- AccessText, not TextBlock: a TextBlock draws the underscore
                     literally, where AccessText turns it into the Alt mnemonic. Same
                     for every worded button below. -->
                <StackPanel Orientation="Horizontal">
                  <ic:SymbolIcon Symbol="Play" Foreground="#FF107C10" />
                  <AccessText Text="_Execute" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Margin="0"
                      Command="{x:Static local:MainWindow.CancelExecutionCommand}"
                      Visibility="{Binding SelectedTab.IsExecuting,
                                   Converter={StaticResource BoolToVisibility},
                                   FallbackValue=Collapsed}"
                      ToolTip="Stop waiting for the running statement (Alt+Break)"
                      AutomationProperties.Name="Cancel execution">
                <StackPanel Orientation="Horizontal">
                  <ic:SymbolIcon Symbol="Stop" />
                  <TextBlock Text="Cancel" Margin="4,0,0,0" VerticalAlignment="Center" />
                  <!-- No mnemonic: Cancel occupies the same cell as Execute, and two
                       buttons claiming Alt+E would be ambiguous. Alt+Break is the
                       gesture, and it is in the tooltip. -->
                </StackPanel>
              </Button>
            </Grid>

            <Button DockPanel.Dock="Left"
                    Command="{x:Static local:MainWindow.ExecuteSelectionCommand}"
                    IsEnabled="{Binding SelectedTab.CanExecute, FallbackValue=False}"
                    ToolTip="Run only the selected text (Ctrl+Enter)"
                    AutomationProperties.Name="Execute selection">
              <ic:SymbolIcon Symbol="PlayCircle" />
            </Button>

            <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarDivider}" />

            <!-- Worded as well as iconned, unlike the rest. Committing when you meant
                 to roll back is not recoverable, and no pair of icons tells those two
                 apart at a glance. PR-3.7 states the transaction in words for the
                 same reason. -->
            <Button DockPanel.Dock="Left" Click="OnCommit"
                    IsEnabled="{Binding SelectedTab.Session,
                                Converter={StaticResource NotNullToBool}, FallbackValue=False}"
                    ToolTip="Commit the open transaction"
                    AutomationProperties.Name="Commit">
              <StackPanel Orientation="Horizontal">
                <ic:SymbolIcon Symbol="CheckmarkCircle" />
                <AccessText Text="Co_mmit" Margin="4,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button DockPanel.Dock="Left" Click="OnRollback"
                    IsEnabled="{Binding SelectedTab.Session,
                                Converter={StaticResource NotNullToBool}, FallbackValue=False}"
                    ToolTip="Roll back the open transaction"
                    AutomationProperties.Name="Roll back">
              <StackPanel Orientation="Horizontal">
                <ic:SymbolIcon Symbol="ArrowUndo" />
                <AccessText Text="Roll _back" Margin="4,0,0,0" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarDivider}" />

            <Button DockPanel.Dock="Left"
                    Command="{x:Static local:MainWindow.CompleteCommand}"
                    ToolTip="Complete the word being typed (Ctrl+Space)"
                    AutomationProperties.Name="Complete word">
              <ic:SymbolIcon Symbol="Keyboard" />
            </Button>

            <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarDivider}" />

            <!-- PR-4.7 keeps every result set until the next run replaces it, so a
                 long session accumulates grids and their cursors. ClearResultsAsync
                 has existed since then with nothing calling it. -->
            <Button DockPanel.Dock="Left"
                    Command="{x:Static local:MainWindow.ClearResultsCommand}"
                    ToolTip="Clear the results and messages"
                    AutomationProperties.Name="Clear results">
              <ic:SymbolIcon Symbol="Eraser" />
            </Button>
            <!-- Only CSV gets a button. TSV, JSON and Excel stay on the Results menu:
                 a split button would need the custom template this toolbar avoids. -->
            <Button DockPanel.Dock="Left" Click="OnExportCsv"
                    IsEnabled="{Binding SelectedTab.SelectedResult,
                                Converter={StaticResource NotNullToBool}, FallbackValue=False}"
                    ToolTip="Export the current result to CSV — the other formats are on the Results menu"
                    AutomationProperties.Name="Export to CSV">
              <ic:SymbolIcon Symbol="ArrowExportUp" />
            </Button>
            <Button DockPanel.Dock="Left" Click="OnCopySelection"
                    ToolTip="Copy the selected cells, tab separated"
                    AutomationProperties.Name="Copy selection">
              <ic:SymbolIcon Symbol="Copy" />
            </Button>
            </DockPanel>
            </ScrollViewer>

            <!-- Not query actions, so they sit apart from the run of buttons. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center" HorizontalAlignment="Right">
              <Border Style="{StaticResource ToolbarDivider}" />
              <Button Click="OnShowHistory"
                      ToolTip="Query history"
                      AutomationProperties.Name="Query history">
                <ic:SymbolIcon Symbol="History" />
              </Button>
              <Button Command="{x:Static local:MainWindow.HelpContentsCommand}"
                      ToolTip="Help contents (F1)"
                      AutomationProperties.Name="Help">
                <ic:SymbolIcon Symbol="QuestionCircle" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Tab headers only. One editor control is shared between tabs, which keeps
             a single AvalonEdit instance and its undo stack predictable. -->
        <!--
          One row that scrolls, rather than WPF's default of wrapping onto extra rows.
          TabPanel wraps once the headers no longer fit, but this strip is a fixed 26px
          — so the second row was drawn outside it and those tabs became unreachable.
          Growing instead would be worse: the strip would eat the editor a row at a
          time, and tabs would jump between rows as the selected one is promoted.

          So: an ItemsPanel that does not wrap, inside a horizontal scroller. The strip
          keeps its height however many tabs are open, and the ones that do not fit are
          a scroll away rather than gone.

          The scrollbar itself is hidden rather than Auto. A visible horizontal bar is
          laid out *inside* the scroller, so it took ~17 of the strip's 26px the moment
          the tabs overflowed — leaving the headers a few pixels tall and looking cut
          off, which is the clipping this was supposed to have fixed. Scrolling is
          driven by the mouse wheel over the strip and by keeping the selected tab in
          view (see MainWindow.xaml.cs), so nothing is lost by not drawing the bar.

          The height is 30 rather than the old 26. WPF promotes the selected tab a
          couple of pixels past the others, so a header measures ~2px taller than the
          plain ones and 26 cut its bottom edge. Dropping the height and letting the
          row measure is not the answer — a ScrollViewer does not pass its content's
          desired height up, so the strip collapsed to 20px instead.
        -->
        <TabControl x:Name="TabHeaders" Grid.Row="1"
                    ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab}"
                    SelectionChanged="OnTabChanged"
                    BorderThickness="0"
                    Padding="0" Height="30">
          <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
              <ScrollViewer x:Name="TabScroller"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled"
                            PreviewMouseWheel="OnTabStripMouseWheel"
                            Focusable="False">
                <!-- ItemsPresenter, not a hardcoded TabPanel, so ItemsPanel below
                     actually takes effect. The content area is deliberately absent:
                     one shared AvalonEdit lives outside this control, and the
                     ContentTemplate is empty for the same reason. -->
                <ItemsPresenter />
              </ScrollViewer>
            </ControlTemplate>
          </TabControl.Template>

          <TabControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </TabControl.ItemsPanel>
          <!--
            Middle-click closes a tab. Hooked on the container rather than on the
            item template so the whole header is the target: aiming at the label is
            not how anyone middle-clicks a tab.

            It is an addition to the ✕ button, never a replacement — NFR-8 needs a
            way to close a tab that does not require a three-button mouse.
          -->
          <TabControl.ItemContainerStyle>
            <Style TargetType="TabItem">
              <EventSetter Event="MouseDown" Handler="OnTabHeaderMouseDown" />
            </Style>
          </TabControl.ItemContainerStyle>
          <TabControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <!-- Capped and elided: a tab named after a long file would otherwise
                     push every other tab off the strip on its own. The full title is
                     on the tooltip, so nothing is lost. -->
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                           MaxWidth="180" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Title}" />
                <Button Content="✕" Margin="6,0,0,0" Padding="3,0" FontSize="10"
                        BorderThickness="0" Background="Transparent"
                        Click="OnCloseTab"
                        ToolTip="Close this tab — or middle-click the tab"
                        AutomationProperties.Name="Close tab" />
              </StackPanel>
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate />
          </TabControl.ContentTemplate>
        </TabControl>

        <!--
          This row is whichever document the selected tab is: the shared editor, an
          object's detail, or the session monitor. They are siblings toggled from
          code-behind rather than a ContentTemplate on the strip above, because that
          strip deliberately renders no content — see the comments on TabHeaders. One
          AvalonEdit serves every editor tab and it has to stay outside.
        -->
        <Grid Grid.Row="2">
          <DockPanel x:Name="EditorHost">
            <!--
              Shown when a cancel freed the editor without stopping the statement, which
              is what this ODBC driver actually does (PR-3.5, measured). It sits above
              the editor rather than in the status bar because the status bar is
              transient and this has to survive the moment: the user's query is still
              consuming server CPU and the way to stop it is in this text.

              Not colour-alone (NFR-8): the wording carries the meaning and the ⚠ gives
              it a shape, so the amber is decoration rather than the signal.
            -->
            <Border DockPanel.Dock="Top"
                    Background="#FFFFF4CE" BorderBrush="#FFE0C060" BorderThickness="0,0,0,1"
                    Padding="8,5"
                    Visibility="{Binding SelectedTab.CancelNotice,
                                 Converter={StaticResource NotNullToVisibility}}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="⚠" FontSize="14" Margin="0,0,8,0"
                           VerticalAlignment="Top" />
                <Button DockPanel.Dock="Right" Content="✕" Padding="4,0" FontSize="10"
                        BorderThickness="0" Background="Transparent"
                        VerticalAlignment="Top"
                        Click="OnDismissCancelNotice"
                        ToolTip="Dismiss"
                        AutomationProperties.Name="Dismiss the cancellation notice" />
                <TextBlock Text="{Binding SelectedTab.CancelNotice}"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="Cancellation notice" />
              </DockPanel>
            </Border>

            <avalonEdit:TextEditor x:Name="Editor"
                                   FontFamily="Consolas" FontSize="13"
                                   ShowLineNumbers="True"
                                   WordWrap="False"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   AutomationProperties.Name="SQL editor" />
          </DockPanel>

          <!-- Content is the selected detail tab's TableDetailViewModel. -->
          <ContentControl x:Name="ObjectDetailHost"
                          Visibility="Collapsed"
                          ContentTemplate="{StaticResource ObjectDetailTemplate}"
                          AutomationProperties.Name="Object detail" />

          <!-- Content is the selected SessionMonitorTabViewModel itself (PR-5.1). -->
          <ContentControl x:Name="SessionMonitorHost"
                          Visibility="Collapsed"
                          ContentTemplate="{StaticResource SessionMonitorTemplate}"
                          AutomationProperties.Name="Session monitor" />
        </Grid>

        <GridSplitter x:Name="ResultsSplitter"
                      Grid.Row="3" Height="4" HorizontalAlignment="Stretch"
                      Background="#FFE0E0E0" />

        <TabControl Grid.Row="4" x:Name="ResultsArea">
          <TabItem x:Name="ResultsTab" Header="Results">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4">
                <TextBlock Text="{Binding SelectedTab.SelectedResult.Status}"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="Result status" />
                <Button Content="Fetch _more" Margin="12,0,0,0" Padding="8,2"
                        Click="OnFetchMore"
                        Visibility="{Binding SelectedTab.SelectedResult.HasMoreRows,
                                     Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>

              <!-- Several result sets kept at once (PR-4.7). Headers only; the grid
                   below is shared, so its dynamic columns are rebuilt once per
                   result rather than per tab switch. -->
              <TabControl x:Name="ResultSetTabs" DockPanel.Dock="Top"
                          ItemsSource="{Binding SelectedTab.Results}"
                          SelectedItem="{Binding SelectedTab.SelectedResult}"
                          SelectionChanged="OnResultSetChanged"
                          BorderThickness="0" Height="24"
                          Visibility="{Binding SelectedTab.Results.Count,
                                       Converter={StaticResource CountToVisibility},
                                       ConverterParameter=2}">
                <TabControl.ItemTemplate>
                  <DataTemplate>
                    <!-- The statement is on the tooltip, so the result can always be
                         traced back to what produced it (PR-8.2). -->
                    <TextBlock Text="{Binding Label}" ToolTip="{Binding Sql}" />
                  </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                  <DataTemplate />
                </TabControl.ContentTemplate>
              </TabControl>

              <DataGrid x:Name="ResultGrid"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserSortColumns="True"
                        SelectionUnit="CellOrRowHeader"
                        SelectionMode="Extended"
                        ClipboardCopyMode="IncludeHeader"
                        EnableRowVirtualization="True"
                        EnableColumnVirtualization="True"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        HeadersVisibility="All"
                        GridLinesVisibility="All"
                        FontFamily="Consolas" FontSize="12"
                        AutomationProperties.Name="Result grid" />
            </DockPanel>
          </TabItem>

          <TabItem x:Name="MessagesTab" Header="Messages">
            <!-- PR-3.4 and PR-3.6: each statement's outcome in sequence, with the
                 failing one named and its SQLCODE and ISAM error shown. -->
            <ListBox ItemsSource="{Binding SelectedTab.Outcomes}"
                     FontFamily="Consolas" FontSize="12"
                     HorizontalContentAlignment="Stretch"
                     AutomationProperties.Name="Statement messages">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource OutcomeText}}"
                             TextWrapping="Wrap" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
