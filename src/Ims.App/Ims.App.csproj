<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF shell (DEC-3). Presentation only — no catalogue or provider logic. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Ims.App</RootNamespace>
    <AssemblyName>Ims</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!--
      The icon Explorer, the taskbar and Alt+Tab use. Generated from
      Resources\ims.png by tools/make-ico.ps1 and committed, so a build needs no
      image tooling. Nine sizes from 16 to 256: Windows picks a different one per
      context, and a single-size icon is a blur everywhere else.
    -->
    <ApplicationIcon>Resources\ims.ico</ApplicationIcon>

    <!--
      Framework-dependent for local development, so a build is fast and does not
      copy a runtime into bin on every compile.

      The shipped build is the opposite: Properties\PublishProfiles\Pilot.pubxml
      sets SelfContained=true, because NFR-7 asks that IMS install without local
      administrator rights and installing the .NET desktop runtime on a managed
      workstation is an administrator action.
    -->
    <SelfContained>false</SelfContained>

    <!--
      A 64-bit process is mandatory, not preferred: it cannot load the 32-bit
      Informix ODBC driver, and CsdkLocator reports that case explicitly. Pinning
      it here means a developer's own build matches what the pilot runs.
    -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="AvalonEdit" />

    <!-- Query toolbar icons. Referenced here only: Ims.Core and Ims.Data.Informix
         stay free of UI dependencies. -->
    <PackageReference Include="FluentIcons.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <!-- PR-3.1: Informix SQL and SPL highlighting, loaded by AvalonEdit at startup. -->
    <EmbeddedResource Include="Resources\InformixSql.xshd" />

    <!--
      ApplicationIcon above sets the icon on the .exe; it does not reach the window
      chrome, which WPF takes from Window.Icon. Same file, included as a WPF Resource
      so the XAML can pack-URI it.
    -->
    <Resource Include="Resources\ims.ico" />

    <!--
      The same artwork as a single cropped PNG, for drawing inside the app at a size
      the layout picks. WPF resolves an .ico to its 16px frame and upscales, so an
      Image bound to the .ico is blurry at any size above 16.
    -->
    <Resource Include="Resources\ims-icon.png" />

    <!-- The original artwork. Not compiled in: it is what tools/make-ico.ps1 reads
         to regenerate the two above. -->
    <None Include="Resources\ims.png" />

    <!--
      User help, opened by Help → Contents in the default browser.

      Content rather than EmbeddedResource: WPF has no HTML renderer, so the file
      has to exist on disk for a browser to open. Copied beside the exe, which also
      puts it in the pilot zip without the publish profile knowing about it.
    -->
    <Content Include="Resources\Help\ims-help.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ims.Core\Ims.Core.csproj" />
    <ProjectReference Include="..\Ims.Data.Informix\Ims.Data.Informix.csproj" />
  </ItemGroup>

</Project>
