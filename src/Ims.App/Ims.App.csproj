<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF shell (DEC-3). Presentation only — no catalogue or provider logic. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Ims.App</RootNamespace>
    <AssemblyName>Ims</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- NFR-7: installable and updatable without local administrator rights. -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ims.Core\Ims.Core.csproj" />
    <ProjectReference Include="..\Ims.Data.Informix\Ims.Data.Informix.csproj" />
  </ItemGroup>

</Project>
