<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF shell (DEC-3). Presentation only — no catalogue or provider logic. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Ims.App</RootNamespace>
    <AssemblyName>Ims</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!--
      Framework-dependent for local development, so a build is fast and does not
      copy a runtime into bin on every compile.

      The shipped build is the opposite: Properties\PublishProfiles\Pilot.pubxml
      sets SelfContained=true, because NFR-7 asks that IMS install without local
      administrator rights and installing the .NET desktop runtime on a managed
      workstation is an administrator action.
    -->
    <SelfContained>false</SelfContained>

    <!--
      A 64-bit process is mandatory, not preferred: it cannot load the 32-bit
      Informix ODBC driver, and CsdkLocator reports that case explicitly. Pinning
      it here means a developer's own build matches what the pilot runs.
    -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="AvalonEdit" />
  </ItemGroup>

  <ItemGroup>
    <!-- PR-3.1: Informix SQL and SPL highlighting, loaded by AvalonEdit at startup. -->
    <EmbeddedResource Include="Resources\InformixSql.xshd" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ims.Core\Ims.Core.csproj" />
    <ProjectReference Include="..\Ims.Data.Informix\Ims.Data.Informix.csproj" />
  </ItemGroup>

</Project>
