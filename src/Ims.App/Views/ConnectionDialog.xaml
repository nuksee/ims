<Window x:Class="Ims.App.Views.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection"
        Height="560" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

  <!--
    PR-1.1 mirrors sqlhosts semantics exactly, so an entry here and a line in a
    sqlhosts file describe the same thing (which is what makes PR-1.9 import
    lossless). PR-1.3 selects the authentication mode per connection, and PR-1.5
    makes the environment an explicit choice rather than something IMS guesses
    from the server name.
  -->

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <GroupBox Header="Identity" Padding="8" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="_Display name" Target="{Binding ElementName=DisplayNameBox}" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="DisplayNameBox" Margin="0,2" />

            <Label Grid.Row="1" Grid.Column="0" Content="_Environment" Target="{Binding ElementName=EnvironmentBox}" />
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="EnvironmentBox" Margin="0,2"
                      AutomationProperties.HelpText="Shown persistently so a production connection cannot be mistaken for another." />

            <Label Grid.Row="2" Grid.Column="0" Content="_Group (optional)" Target="{Binding ElementName=GroupBox2}" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="GroupBox2" Margin="0,2" />
          </Grid>
        </GroupBox>

        <GroupBox Header="Server (sqlhosts)" Padding="8" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="_Server name" Target="{Binding ElementName=ServerNameBox}" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="ServerNameBox" Margin="0,2" />

            <Label Grid.Row="1" Grid.Column="0" Content="_Host" Target="{Binding ElementName=HostBox}" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="HostBox" Margin="0,2" />

            <Label Grid.Row="2" Grid.Column="0" Content="Ser_vice / port" Target="{Binding ElementName=ServiceBox}" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ServiceBox" Margin="0,2" />

            <Label Grid.Row="3" Grid.Column="0" Content="_Protocol" Target="{Binding ElementName=ProtocolBox}" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="ProtocolBox" Margin="0,2" Text="onsoctcp" />

            <Label Grid.Row="4" Grid.Column="0" Content="Data_base" Target="{Binding ElementName=DatabaseBox}" />
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="DatabaseBox" Margin="0,2" />

            <Button Grid.Row="5" Grid.Column="1" x:Name="ImportButton"
                    Content="Import from this machine's sqlhosts…"
                    HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,3"
                    Click="OnImportSqlHosts" />
          </Grid>
        </GroupBox>

        <GroupBox Header="Authentication" Padding="8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="_Mode" Target="{Binding ElementName=AuthModeBox}" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="AuthModeBox" Margin="0,2" />

            <Label Grid.Row="1" Grid.Column="0" Content="_User name" Target="{Binding ElementName=UserNameBox}" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="UserNameBox" Margin="0,2" />

            <Label Grid.Row="2" Grid.Column="0" Content="Pass_word" Target="{Binding ElementName=PasswordBox}" />
            <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="PasswordBox" Margin="0,2" />

            <TextBlock Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="#FF5F6368"
                       Text="Stored in Windows Credential Manager, never in a file IMS writes. Leave blank to be asked at connect time." />
          </Grid>
        </GroupBox>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="OkButton" Content="_Save" MinWidth="90" Padding="10,4" Margin="0,0,8,0"
              IsDefault="True" Click="OnSave" />
      <Button x:Name="CancelButton" Content="_Cancel" MinWidth="90" Padding="10,4"
              IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
