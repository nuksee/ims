<Window x:Class="Ims.App.Views.PrerequisiteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informix Management Studio — prerequisite missing"
        Icon="/Resources/ims.ico"
        Height="420" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

  <!--
    PR-1.8: report a missing or misconfigured Client SDK clearly at startup,
    not as a connection failure.

    NFR-8: state is carried by the heading text and the labelled fields, never
    by colour alone, and every control is reachable and labelled for a screen
    reader.
  -->

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               x:Name="HeadingBlock"
               Style="{StaticResource HeadingText}"
               Margin="0,0,0,12"
               Text="Informix Client SDK not available" />

    <TextBlock Grid.Row="1"
               x:Name="MessageBlock"
               Style="{StaticResource BodyText}"
               AutomationProperties.Name="What is wrong" />

    <TextBlock Grid.Row="2"
               x:Name="RemedyBlock"
               Style="{StaticResource BodyText}"
               FontWeight="SemiBold"
               AutomationProperties.Name="What to do about it" />

    <GroupBox Grid.Row="3"
              Header="Detected configuration"
              Margin="0,8,0,12">
      <TextBox x:Name="DetailsBox"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               FontFamily="Consolas"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto"
               BorderThickness="0"
               Background="Transparent"
               AutomationProperties.Name="Detected Client SDK configuration" />
    </GroupBox>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CopyButton"
              Content="_Copy details"
              MinWidth="110"
              Margin="0,0,8,0"
              Padding="10,4"
              Click="OnCopyDetails" />
      <Button x:Name="CloseButton"
              Content="_Close"
              MinWidth="110"
              Padding="10,4"
              IsCancel="True"
              IsDefault="True"
              Click="OnClose" />
    </StackPanel>
  </Grid>
</Window>
