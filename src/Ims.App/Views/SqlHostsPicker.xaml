<Window x:Class="Ims.App.Views.SqlHostsPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import from sqlhosts"
        Height="420" Width="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="Entries found on this machine. The registry and the sqlhosts file are both shown, and are not merged — where they disagree, the difference is worth seeing." />

    <DataGrid Grid.Row="1" x:Name="EntriesGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Single"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              MouseDoubleClick="OnDoubleClick">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="150" />
        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="90" />
        <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="180" />
        <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="80" />
        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="80" />
        <DataGridTextColumn Header="Options" Binding="{Binding Options}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="_Use this entry" MinWidth="110" Padding="10,4" Margin="0,0,8,0"
              IsDefault="True" Click="OnAccept" />
      <Button Content="_Cancel" MinWidth="90" Padding="10,4" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
