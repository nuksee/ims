<Window x:Class="Ims.App.Views.PasswordPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password required"
        SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

  <StackPanel Margin="16">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10" />

    <Label Content="Pass_word" Target="{Binding ElementName=PasswordEntry}" />
    <PasswordBox x:Name="PasswordEntry" Margin="0,2,0,10" />

    <CheckBox x:Name="RememberBox"
              Content="_Remember in Windows Credential Manager"
              Margin="0,0,0,4" />

    <TextBlock TextWrapping="Wrap" Foreground="#FF5F6368" FontSize="11"
               Text="IMS never writes a password to a file of its own. Leaving this unticked keeps it in memory for this connection only." />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="_Connect" MinWidth="90" Padding="10,4" Margin="0,0,8,0"
              IsDefault="True" Click="OnAccept" />
      <Button Content="_Cancel" MinWidth="90" Padding="10,4" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
