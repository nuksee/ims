<Application x:Class="Ims.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <!--
    No StartupUri. Which window opens depends on whether the Client SDK is
    usable (PR-1.8), so App.OnStartup decides.
  -->
  <Application.Resources>
    <Style TargetType="TextBlock" x:Key="HeadingText">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="TextBlock" x:Key="BodyText">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </Application.Resources>
</Application>
